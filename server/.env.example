# ============================================================
# Uday Electrical Works - Backend API environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================

# Server
PORT=5000

# Environment: development | production
# - development connects to the uday_electrical_dev database
# - production connects to the uday_electrical_production database
#   (separate databases - dev and prod data never mix)
NODE_ENV=production

# Database connection string (MongoDB).
# If unset, defaults to mongodb://127.0.0.1:27017/uday_electrical_dev
# (development) or .../uday_electrical_production (production).
# The database NAME inside the URI is always forced per environment.
MONGO_URI=mongodb://127.0.0.1:27017/uday_electrical_production

# JWT signing secret - MUST be a long random string in production.
# The server refuses to start in production with a missing or placeholder value.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=30d

# CORS - allowed frontend origins (comma separated).
# CLIENT_URL is kept for backward compatibility; CLIENT_URLS is the full allowlist.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Production origins (fill in when deploying):
# CLIENT_URLS=https://www.udayelectricalworks.in,https://admin.udayelectricalworks.in,https://technician.udayelectricalworks.in

# Razorpay - required for REAL online payments.
# Online payment is NEVER simulated in production: without these keys the
# payment API returns 503 and the customer UI directs users to pay at the shop.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP email - when unset, emails are only logged to the console (dev only).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# First-admin creation (npm run create-admin) - optional; the script also
# prompts interactively. It refuses to run if an Admin account already exists.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Business store configuration
STORE_NAME="Uday Electrical Works"
STORE_PHONE_PRIMARY="7903789402"
STORE_PHONE_SECONDARY="9934187847"
STORE_LOCATION="Chhota Govindpur, Jamshedpur, Jharkhand - 831015"
