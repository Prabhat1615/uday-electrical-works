# Customer Web — environment variables
# Copy to .env.local for local development (never commit real .env files).

# Backend API base URL.
# Development:   http://localhost:5000/api  (or omit — falls back to the Vite proxy)
# Production:    https://api.udayelectricalworks.in/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (real-time notifications, chat).
# Development:   http://localhost:5000
# Production:    https://api.udayelectricalworks.in
VITE_SOCKET_URL=http://localhost:5000

# Public site URL used by the sitemap generator (scripts/generate-sitemap.mjs).
# Production:    https://www.udayelectricalworks.in
SITE_URL=https://www.udayelectricalworks.in
