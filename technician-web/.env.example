# Technician Web — environment variables
# Copy to .env.local for local development (never commit real .env files).

# Backend API base URL.
# Development:   http://localhost:5000/api  (or omit — falls back to the Vite proxy)
# Production:    https://uday-electrical-works.onrender.com
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (real-time job assignments, field service updates).
# Development:   http://localhost:5000
# Production:    https://uday-electrical-works.onrender.com
VITE_SOCKET_URL=http://localhost:5000
